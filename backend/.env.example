# ---- Required ----
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Optional ----
PORT=8080
OPENAI_MODEL=gpt-4o-mini
# Comma-separated. Leave blank to allow any origin (native apps send no Origin header).
ALLOWED_ORIGINS=
# Shared secret the iOS app sends as `x-civicai-key`. Leave blank to disable.
APP_SHARED_SECRET=
